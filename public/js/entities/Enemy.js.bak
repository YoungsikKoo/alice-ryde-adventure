class Enemy extends Entity{constructor(game,cfg){super(game,{x:cfg.x,y:cfg.y,width:cfg.width||32,height:cfg.height||32,speed:cfg.speed||1,color:cfg.color||"#e84855",type:"enemy",tags:["enemy"]});this.enemyType=cfg.enemyType||"default";this.name=cfg.name||"Enemy";this.hp=cfg.hp||20;this.maxHp=this.hp;this.atk=cfg.atk||5;this.def=cfg.def||0;this.contactDamage=cfg.contactDamage||this.atk;this.expReward=cfg.expReward||5;this.ai=cfg.ai||"wander";this.aggroRange=cfg.aggroRange||80;this.chaseSpeed=(cfg.speed||1)*1.3;this.wanderTimer=0;this.wanderInterval=2+Math.random()*3;this.wanderDir={x:0,y:0};this.patrolPoints=cfg.patrolPoints||[];this.patrolIndex=0;this.alive=true;this.lootTable=cfg.lootTable||[];this.showHP=cfg.showHP!==false}update(dt){if(!this.alive||!this.active)return;const tgt=this._nearestPlayer();const dist=tgt?this.distanceTo(tgt):Infinity;if(this.ai==="chase"&&dist<this.aggroRange&&tgt.alive)this._chase(tgt,dt);else if(this.ai==="stationary"){}else{if(dist<this.aggroRange*0.5&&tgt&&tgt.alive)this._chase(tgt,dt);else this._wander(dt)}super.update(dt)}_nearestPlayer(){let n=null,md=Infinity;for(const p of this.game.players){if(!p.alive)continue;const d=this.distanceTo(p);if(d<md){md=d;n=p}}return n}_chase(tgt,dt){const dx=tgt.x-this.x,dy=tgt.y-this.y,d=Math.sqrt(dx*dx+dy*dy)||1;this.moveWithCollision((dx/d)*this.chaseSpeed,(dy/d)*this.chaseSpeed,this.game.tileMap);if(Math.abs(dx)>Math.abs(dy))this.direction=dx>0?"right":"left";else this.direction=dy>0?"down":"up"}_wander(dt){this.wanderTimer-=dt;if(this.wanderTimer<=0){this.wanderTimer=this.wanderInterval+Math.random()*2;const a=Math.random()*Math.PI*2;this.wanderDir=Math.random()<0.3?{x:0,y:0}:{x:Math.cos(a)*this.speed*0.5,y:Math.sin(a)*this.speed*0.5}}if(this.wanderDir.x||this.wanderDir.y)this.moveWithCollision(this.wanderDir.x,this.wanderDir.y,this.game.tileMap)}takeDamage(amt,atk){if(!this.alive)return;this.hp-=amt;this._playHurtSound();if(atk){const dx=this.x-atk.x,dy=this.y-atk.y,d=Math.sqrt(dx*dx+dy*dy)||1;this.vx=(dx/d)*3;this.vy=(dy/d)*3}if(this.hp<=0){this.hp=0;this.alive=false;this._playDeathSound()}}_playHurtSound(){try{const s=this.game.sound;if(!s||!s.ctx||s.muted)return;const t=s.ctx.currentTime;const sounds={cockroach:{f:800,f2:400,dur:0.08,type:"square"},pigeon:{f:600,f2:900,dur:0.1,type:"sine"},cockatoo:{f:1200,f2:600,dur:0.15,type:"sawtooth"},rat:{f:900,f2:500,dur:0.07,type:"square"},binChicken:{f:300,f2:150,dur:0.12,type:"sawtooth"},bugSwarm:{f:200,f2:400,dur:0.05,type:"square"},dogPoo:{f:100,f2:50,dur:0.1,type:"sine"},default:{f:500,f2:250,dur:0.1,type:"square"}};const cfg=sounds[this.enemyType]||sounds.default;const o=s.ctx.createOscillator(),g=s.ctx.createGain();o.type=cfg.type;o.frequency.setValueAtTime(cfg.f,t);o.frequency.exponentialRampToValueAtTime(cfg.f2,t+cfg.dur);g.gain.setValueAtTime(0.2,t);g.gain.exponentialRampToValueAtTime(0.001,t+cfg.dur);o.connect(g);g.connect(s.sfxGain);o.start(t);o.stop(t+cfg.dur)}catch(e){}}_playDeathSound(){try{const s=this.game.sound;if(!s||!s.ctx||s.muted)return;const t=s.ctx.currentTime;const sounds={cockroach:{notes:[600,300,100],dur:0.08,type:"square"},pigeon:{notes:[800,600,400,200],dur:0.06,type:"sine"},cockatoo:{notes:[1400,1000,600,200],dur:0.07,type:"sawtooth"},rat:{notes:[700,400,150],dur:0.07,type:"square"},binChicken:{notes:[400,250,100],dur:0.1,type:"sawtooth"},bugSwarm:{notes:[300,200,100],dur:0.05,type:"square"},default:{notes:[500,300,100],dur:0.08,type:"square"}};const cfg=sounds[this.enemyType]||sounds.default;cfg.notes.forEach((f,i)=>{const o=s.ctx.createOscillator(),g=s.ctx.createGain();o.type=cfg.type;o.frequency.value=f;g.gain.setValueAtTime(0.25,t+i*cfg.dur);g.gain.exponentialRampToValueAtTime(0.001,t+i*cfg.dur+cfg.dur);o.connect(g);g.connect(s.sfxGain);o.start(t+i*cfg.dur);o.stop(t+i*cfg.dur+cfg.dur)})}catch(e){}}render(ctx,camera){super.render(ctx,camera);if(this.alive&&this.showHP&&this.hp<this.maxHp){const sp=camera.worldToScreen(this.x,this.y);const pr=this.hp/this.maxHp;ctx.fillStyle="#300";ctx.fillRect(sp.x,sp.y-5,this.width,3);ctx.fillStyle="#e84855";ctx.fillRect(sp.x,sp.y-5,Math.floor(this.width*pr),3)}}}class Cockroach extends Enemy{constructor(g,c){super(g,{...c,enemyType:"cockroach",name:"Cockroach",hp:18,atk:5,def:1,speed:2.0,color:"#5c3d2e",aggroRange:60,ai:"wander",expReward:4,width:24,height:24})}}class Pigeon extends Enemy{constructor(g,c){super(g,{...c,enemyType:"pigeon",name:"Cheeky Pigeon",hp:15,atk:4,def:0,speed:1.7,color:"#8888aa",aggroRange:50,ai:"wander",expReward:3,width:20,height:20})}}class Cockatoo extends Enemy{constructor(g,c){super(g,{...c,enemyType:"cockatoo",name:"Screaming Cockatoo",hp:30,atk:9,def:2,speed:1.4,color:"#f5f5dc",aggroRange:90,ai:"chase",expReward:8})}}class ShopRat extends Enemy{constructor(g,c){super(g,{...c,enemyType:"rat",name:"Shop Rat",hp:22,atk:6,def:1,speed:2.4,color:"#666655",aggroRange:40,ai:"chase",expReward:5,width:20,height:16})}}class BinChicken extends Enemy{constructor(g,c){super(g,{...c,enemyType:"binChicken",name:"Bin Chicken",hp:36,atk:8,def:3,speed:1.2,color:"#e8e0d0",aggroRange:70,ai:"wander",expReward:10})}}class BugSwarm extends Enemy{constructor(g,c){super(g,{...c,enemyType:"bugSwarm",name:"Bug Swarm",hp:10,atk:3,def:0,speed:1.2,color:"#2a5a1a",aggroRange:100,ai:"chase",expReward:2,width:24,height:24})}}class DogPoo extends Enemy{constructor(g,c){super(g,{...c,enemyType:"dogPoo",name:"Dog Poo",hp:1,atk:0,def:0,speed:0,color:"#6b4226",ai:"stationary",expReward:1,width:16,height:16,contactDamage:0});this.showHP=false}takeDamage(){this.alive=false;this.game.combat.spawnDamageNumber(this.x+8,this.y-8,"Eww! Cleaned!","#6b4226");this.destroy()}}