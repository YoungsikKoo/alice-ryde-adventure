class Stage1{constructor(){this.game=null;this.mapData=null;this.miniBoss=null;this.miniBossDefeated=false;this.exitUnlocked=false;this.bossTriggered=false;this.ambientTimer=0;this.ambientInterval=25;this.complete=false;this.friendsJoined=new Set();this.friendJoinZones=[]}async init(game){this.game=game;game.hud.showStageName("~ Stage 1: The Neighbourhood ~");game.hud.addChatMessage("Watch out for bugs and dog poo!","#f0d060");this.mapData=this._fallbackMap();game.tileMap=new TileMap(game);game.tileMap.load(this.mapData,null);const sp=this.mapData.spawns.alice||{x:8,y:42};game.localPlayer.x=sp.x*16;game.localPlayer.y=sp.y*16;game.camera.follow(game.localPlayer);game.camera.x=game.localPlayer.x-240;game.camera.y=game.localPlayer.y-160;this._spawnNPCs();this._spawnEnemies();this._spawnItems();this._setupBoss();setTimeout(()=>{game.startDialogue([{speaker:"Alice",text:"Time to walk to school. How hard can it be?"},{speaker:"Alice",text:"...Why is there a cockroach the size of a dog?!"},{speaker:"Alice",text:"WASD to move, SPACE to attack, E to talk. Lets go!"}],()=>{if(game.sound)game.sound.playBGM("stage1")})},1000)}_spawnNPCs(){if(!this.mapData.npcs)return;for(const n of this.mapData.npcs){const npc=new NPC(this.game,{x:n.x*16,y:n.y*16,name:n.name,color:n.color,npcType:n.npcType||"talk",dialogue:n.dialogue||[]});this.game.addEntity(npc)}}_spawnEnemies(){if(!this.mapData.enemies)return;const cls={dogPoo:DogPoo,bugSwarm:BugSwarm,cockroach:Cockroach,pigeon:Pigeon};for(const g of this.mapData.enemies){const C=cls[g.type]||Enemy;for(const pos of g.positions)this.game.addEntity(new C(this.game,{x:pos.x*16,y:pos.y*16}))}}_spawnItems(){const all=[...(this.mapData.items||[]),...(this.mapData.healPickups||[])];for(const i of all){const item=new ItemDrop(this.game,{x:i.x*16,y:i.y*16,itemData:i.item});item.lifetime=9999;this.game.addEntity(item)}}_setupBoss(){if(!this.mapData.miniBoss)return;const mb=this.mapData.miniBoss;this.miniBoss=new Enemy(this.game,{x:mb.x*16,y:mb.y*16,enemyType:"cockroach",name:mb.name,hp:mb.hp||150,atk:mb.atk||12,def:mb.def||5,speed:1.5,color:"#3a2010",aggroRange:120,ai:"chase",expReward:30,width:40,height:40,lootTable:mb.lootTable||[]});this.miniBoss.isBoss=true;this.miniBoss.active=false;this.miniBoss.visible=false;this.game.addEntity(this.miniBoss)}update(dt){if(this.miniBoss&&!this.bossTriggered&&!this.miniBossDefeated){const pl=this.game.localPlayer,d=Math.sqrt(Math.pow(pl.x-this.miniBoss.x,2)+Math.pow(pl.y-this.miniBoss.y,2));if(d<120)this._triggerBoss()}if(this.miniBoss&&this.bossTriggered&&!this.miniBossDefeated&&this.miniBoss.hp<=0)this._bossDefeated();if(this.exitUnlocked)this._checkExit();this.ambientTimer+=dt;if(this.ambientTimer>=this.ambientInterval){this.ambientTimer=0;if(this.mapData.ambientDialogue){const pool=this.mapData.ambientDialogue;this.game.hud.addChatMessage(pool[Math.floor(Math.random()*pool.length)],"#aaa")}}}_triggerBoss(){this.bossTriggered=true;this.miniBoss.active=true;this.miniBoss.visible=true;this.game.camera.shake(5,0.5);this.game.hud.setBoss(this.miniBoss,this.miniBoss.name);if(this.game.sound)this.game.sound.playBossAppear();const mb=this.mapData.miniBoss;if(mb.dialogue)this.game.startDialogue(mb.dialogue);this.game.hud.addChatMessage("BOSS: "+this.miniBoss.name+" appeared!","#f44")}_bossDefeated(){this.miniBossDefeated=true;this.exitUnlocked=true;this.game.hud.clearBoss();const mb=this.mapData.miniBoss;if(mb.defeatDialogue)setTimeout(()=>this.game.startDialogue(mb.defeatDialogue),500);this.game.hud.addChatMessage("Path to Top Ryde City is open! Head north-east!","#50c878")}_checkExit(){if(this.complete)return;const pl=this.game.localPlayer;for(const e of(this.mapData.exits||[])){const ex=e.x*16,ey=e.y*16,ew=(e.w||3)*16,eh=(e.h||3)*16;if(pl.x>=ex&&pl.x<=ex+ew&&pl.y>=ey&&pl.y<=ey+eh){this.complete=true;this.game.startDialogue([{speaker:"Alice",text:"We made it to Top Ryde City!"},{speaker:"Alice",text:"I hope the food court is still open. STARVING."}],()=>this.onExit("stage2"))}}}onExit(target){if(target==="stage2"){if(this.game.sound)this.game.sound.stopBGM();this.game.transition.startFade(()=>{this.game.loadStage(new Stage2())},()=>{})}}_fallbackMap(){const W=60,H=50,g=[],c=[];for(let y=0;y<H;y++){const gr=[],cr=[];for(let x=0;x<W;x++){if(x===0||x===W-1||y===0||y===H-1){gr.push(4);cr.push(1)}else if(x>=28&&x<=31){gr.push(1);cr.push(0)}else if((y>=22&&y<=24)||(y>=38&&y<=40)){gr.push(1);cr.push(0)}else if(Math.random()<0.03){gr.push(7);cr.push(1)}else{gr.push(0);cr.push(0)}}g.push(gr);c.push(cr)}return{width:W,height:H,ground:g,collision:c,above:[],events:[],spawns:{alice:{x:8,y:42},friend1:{x:20,y:35,name:"Friend 1"},friend2:{x:45,y:42,name:"Friend 2"}},exits:[{x:55,y:2,w:4,h:4,target:"stage2",trigger:"touch",message:"Reached Top Ryde City!"}],npcs:[{name:"Dave",x:15,y:38,color:"#4a90d9",npcType:"talk",dialogue:[[{speaker:"Dave",text:"Gday! Watch out for dog poo!"},{speaker:"Dave",text:"My dog Biscuit left some surprises..."}]]},{name:"Nanna Joy",x:42,y:20,color:"#dda0dd",npcType:"heal"}],enemies:[{type:"dogPoo",positions:[{x:18,y:37},{x:22,y:30},{x:30,y:42},{x:38,y:35}]},{type:"bugSwarm",positions:[{x:20,y:20},{x:32,y:18},{x:48,y:30}]},{type:"cockroach",positions:[{x:25,y:25},{x:38,y:22},{x:50,y:15}]},{type:"pigeon",positions:[{x:28,y:32},{x:35,y:40}]}],items:[{x:10,y:38,item:{name:"Trash Lid",type:"armor",equipSlot:"armor",def:2,color:"#aaa",pickupMessage:"Trash lid shield!"}},{x:30,y:36,item:{name:"Water Gun",type:"weapon",equipSlot:"weapon",atk:3,color:"#4a90d9",pickupMessage:"Water gun! Pew pew!"}}],healPickups:[{x:12,y:30,item:{name:"Juice Box",type:"consumable",heal:15,color:"#f90",pickupMessage:"Apple juice!"}},{x:38,y:30,item:{name:"Vegemite Sanga",type:"consumable",heal:20,color:"#4a3520",pickupMessage:"Vegemite sandwich!"}},{x:8,y:20,item:{name:"Golden Gaytime",type:"consumable",heal:25,color:"#f0d060",pickupMessage:"Golden Gaytime!! Best. Find. EVER."}},{x:35,y:8,item:{name:"Tim Tam Slam",type:"consumable",heal:30,color:"#4a2810",pickupMessage:"Tim Tam Slam!"}}],miniBoss:{type:"giantCockroach",x:52,y:6,name:"COCKROACH KING",hp:180,atk:15,def:6,dialogue:[{speaker:"???",text:"You hear horrible skittering..."},{speaker:"COCKROACH KING",text:"HISSSS! THIS IS MY STREET NOW!"}],defeatDialogue:[{speaker:"Alice",text:"DISGUSTING but we did it!"},{speaker:"Alice",text:"Path to Top Ryde City is clear!"}],lootTable:[{item:{name:"Roach Crown",type:"accessory",equipSlot:"accessory",atk:2,def:2,color:"#5c3d2e"},chance:1},{item:{name:"Tim Tam Family Pack",type:"consumable",heal:50,color:"#4a2810",pickupMessage:"A WHOLE FAMILY PACK!!"},chance:1}]},ambientDialogue:["A magpie swoops overhead. It missed!","BBQ smells amazing. Focus!","A kookaburra laughs at you. Rude.","Was that a huntsman?! ...Just a leaf. PHEW."]}}}